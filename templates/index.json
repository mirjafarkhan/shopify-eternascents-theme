    "faq_template_v1_7DeUK3": {
      "type": "FAQ-template-v1",
      "blocks": {
        "faq_left_pUWpYb": {
          "type": "faq_left",
          "settings": {
            "block_title_question": "What courier do you use for deliveries?",
            "block_description_question": "We use Royal mail and DHL to send most of our UK orders.Euro Car Parts reserves the right to use discretion in any circumstance where it makes more sense to use an alternative delivery method."
          }
        },
        "faq_left_iwq8Gc": {
          "type": "faq_left",
          "settings": {
            "block_title_question": "How long does it take for home delivery?",
            "block_description_question": "We currently offer 3 types of delivery service :standard delivery for GB Mainland in approximately 2-4 working days; Super Saver 48 Hour Delivery; Premium Next Day. More on our Delivery Services."
          }
        },
        "faq_left_XAXkrk": {
          "type": "faq_left",
          "settings": {
            "block_title_question": "I placed an order on Friday for next day delivery, why did I not get it until Tuesday?",
            "block_description_question": "Our cut off point is 4pm, Monday to Friday. Any order placed after 4pm will be processed through our dispatch system the next working day. We currently do not deliver at weekends."
          }
        },
        "faq_left_R7T44k": {
          "type": "faq_left",
          "settings": {
            "block_title_question": "Why am I being charged for delivery on my order when it states standard delivery is free?",
            "block_description_question": "All our delivery charges are pre-set by our courier company. We sell some oversized items which require a specialist courier company to fulfil the delivery, there is an additional charge for these. Also, our courier company consider some surcharge postcodes ‘Out of area’. There is an additional charge for these also. You can find a list of all [oversized items here] You can find a list of all"
          }
        },
        "faq_left_KcFgiM": {
          "type": "faq_left",
          "settings": {
            "block_title_question": "I haven’t received a dispatch email/email confirmation?",
            "block_description_question": "Please be aware an automated email is sent to you to the given email address when your order is dispatched. Please check all folders including you junk as it will come from a noreply email address. To ensure emails reach you, add the domain eurocarparts.com to your safe senders list."
          }
        },
        "faq_left_EFeTFY": {
          "type": "faq_left",
          "settings": {
            "block_title_question": "Why does it not tell us on the website that the parts will be delivered by the branch?",
            "block_description_question": "Due to the delicacy of some parts we take extra care in the delivery of the item. These could include body panels and large bulky items. These are either available for collection from our branches or will be delivered to you through our branch network vehicles."
          }
        },
        "faq_left_wxBUbx": {
          "type": "faq_left",
          "settings": {
            "block_title_question": "Can I collect from a local store?",
            "block_description_question": "We offer a reserve and collect service. This is available on the checkout page. Please be aware, if the product is not available in a local store, you are unable to reserve it."
          }
        },
        "faq_left_p6gyYG": {
          "type": "faq_left",
          "settings": {
            "block_title_question": "Do you deliver on Weekend?",
            "block_description_question": "No, our courier company do not offer the service to deliver on weekends currently."
          }
        },
        "faq_left_UCL47z": {
          "type": "faq_left",
          "settings": {
            "block_title_question": "Why can’t I select next day delivery?",
            "block_description_question": "We can only offer next day on goods we have in stock at our dispatch depot."
          }
        },
        "faq_left_LBD7zP": {
          "type": "faq_left",
          "settings": {
            "block_title_question": "Can I track my item?",
            "block_description_question": "Yes. You will be sent a dispatch confirmation email as soon as your order has been processed. This email will also contain your tracking number. We also ask for a mobile number so our courier can inform you of the status of your order.Please visit: www.dhl.co.uk/en/express/tracking.html for International orders shipped via DHLwww.ups.com for all orders shipped by UPSwww.tuffnells.co.uk/proof-of-delivery for all oversized orders shipped by TuffnellsPlease note tracking numbers are only active and trackable 2 hours after the order has been collected from our warehouse, approximately 8pm (GMT/BST) Monday to Friday. For orders placed after 4pm on Friday, your order will may not be trackable until it has been collected from us the following Monday."
          }
        },
        "faq_left_prtxDz": {
          "type": "faq_left",
          "settings": {
            "block_title_question": "Can I collect from a local store?",
            "block_description_question": "We offer a reserve and collect service. This is available on the checkout page. Please be aware, if the product is not available in a local store, you are unable to reserve it."
          }
        },
        "faq_right_CecnfD": {
          "type": "faq_right",
          "settings": {
            "block_title_question2": "Can you confirm you have received my return?",
            "block_description_question2": "We aim to process returns within 5-7 working days of receiving them. You will be notified by email once the return is complete.We suggest you make a note of the shipping reference given when you sent the item back. This will allow you to track your parcel at every stage of delivery, including when we receive it.Should you have any queries about your return, please feel free to contact our Customer Service team via email"
          }
        },
        "faq_right_JMfCw3": {
          "type": "faq_right",
          "settings": {
            "block_title_question2": "How long will it be before I get a refund?",
            "block_description_question2": "Once we receive your item(s) back, our returns department will inspect and restock the goods. Once our returns department have done this, an automated refund is generated on our system. Your outstanding refund is then processed by our accounts department back to your original payment method. This process typically takes 5-7 working days. When returning your products please remember to include your original invoice, without this it may delay your refund."
          }
        },
        "faq_right_wFJg7U": {
          "type": "faq_right",
          "settings": {
            "block_title_question2": "Who pays for return postage?",
            "block_description_question2": "If you are returning an unsuitable item for a refund we will refund the cost of the item only and not the original delivery cost.Should you be returning a faulty item for a refund we will refund both the original shipping costs and the return delivery costs."
          }
        },
        "faq_right_p6aBdg": {
          "type": "faq_right",
          "settings": {
            "block_title_question2": "Why have you not refunded the original delivery charge?",
            "block_description_question2": "If you are returning an unsuitable item for a refund we will refund the cost of the item only and not the original delivery cost. Should you be returning a faulty item for a refund we will refund both the original shipping costs and the return delivery costs."
          }
        },
        "faq_right_JKaiym": {
          "type": "faq_right",
          "settings": {
            "block_title_question2": "How do I apply a promotional code?",
            "block_description_question2": "You can add a valid promotion code in the Basket."
          }
        },
        "faq_right_xTiQHF": {
          "type": "faq_right",
          "settings": {
            "block_title_question2": "Do you offer a VAT discount to non EU customers?",
            "block_description_question2": "Customer’s ordering from outside the European Union can contact us via telephone, live chat, or e-mail and quote the order reference number. Our customer services team will go through the process to remove the VAT off of their order."
          }
        },
        "faq_right_6j9RH6": {
          "type": "faq_right",
          "settings": {
            "block_title_question2": "When will my card be charged for my order?",
            "block_description_question2": "Due to the nature of our payments system, the full cost of the order will be charged to the card as soon as it is placed."
          }
        },
        "faq_right_CeVWHp": {
          "type": "faq_right",
          "settings": {
            "block_title_question2": "Where is my order?",
            "block_description_question2": "Most of our deliveries are sent via UPS and we will send you an automated email with the tracking number of your order. You can also find the tracking number on your order in My Account"
          }
        },
        "faq_right_UgiPhr": {
          "type": "faq_right",
          "settings": {
            "block_title_question2": "Where do I find the phone number for one of your branches?",
            "block_description_question2": "You can find details for any branch, in our store locator section. This is located at the top right of every page on our website or Find a store here."
          }
        },
        "faq_right_rz9NUW": {
          "type": "faq_right",
          "settings": {
            "block_title_question2": "How can I make a complaint?",
            "block_description_question2": "In the rare occasion we make a mistake we are more than happy to take all customer feedback. There is always room for improvement. Contact Us"
          }
        },
        "faq_right_BFkQrw": {
          "type": "faq_right",
          "settings": {
            "block_title_question2": "Is it possible to change the address/cancel or amend my order?",
            "block_description_question2": "Due to the high volume of orders we receive, we have an automatic invoicing system. For any changes to your order, please call us immediately after placing the order. We can attempt to stop or amend your order with our dispatch team, if it is not possible, we will advise you on the next steps."
          }
        }
      },
